int sensorPin = A0;  // LDR sensor connected to A0
int ledPin = 8;      // LED connected to pin 8

int sensorValue = 0; // Stores sensor reading

void setup() {
  pinMode(ledPin, OUTPUT); // Set LED as output
  Serial.begin(9600);      // Start Serial Monitor
}

void loop() {
  sensorValue = analogRead(sensorPin); // Read light level

  Serial.println(sensorValue); // Display reading

  if (sensorValue < 500) {
    digitalWrite(ledPin, HIGH); // Turn LED ON
  } else {
    digitalWrite(ledPin, LOW);  // Turn LED OFF
  }

  delay(500); // Wait 500 milliseconds
}
